{
  "manifest_version": 3,
  "name": "OG eBay Order Link",
  "description": "Connects eBay orders and separate TikTok exports, receipts and shipping labels to OG.",
  "version": "1.0.22",
  "permissions": [
    "storage",
    "activeTab",
    "tabs",
    "downloads",
    "clipboardWrite",
    "unlimitedStorage"
  ],
  "host_permissions": [
    "<all_urls>",
    "https://www.ebay.com/*",
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "background": {
    "service_worker": "worker.js"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "label-capture-probe.js",
        "report-capture-probe.js"
      ],
      "matches": [
        "https://www.ebay.com/*"
      ]
    },
    {
      "resources": ["online-print-page.js"],
      "matches": ["https://*/*", "http://localhost/*", "http://127.0.0.1/*"]
    }
  ],
  "content_scripts": [
    {
      "matches": ["https://seller-us.tiktok.com/*"],
      "js": ["tiktok-print-probe.js", "tiktok-report-probe.js"],
      "world": "MAIN",
      "run_at": "document_start"
    },
    {
      "matches": ["https://seller-us.tiktok.com/*"],
      "js": ["tiktok-print.js", "tiktok-receipt-capture.js", "tiktok-export.js", "tiktok-orders.js", "tiktok-shipping.js"],
      "run_at": "document_start"
    },
    {
      "matches": ["https://www.ebay.com/ship/*"],
      "js": ["shipping-combine-policy.js", "shipping-combine-guard.js"],
      "run_at": "document_start"
    },
    {
      "matches": [
        "https://www.ebay.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    },
    {
      "matches": [
        "https://*/*",
        "http://localhost/*",
        "http://127.0.0.1/*"
      ],
      "js": [
        "app-bridge.js",
        "online-print-bridge.js",
        "tiktok-orders-bridge.js",
        "tiktok-labels-bridge.js",
        "tiktok-receipt-bridge.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "options_page": "options.html",
  "action": {
    "default_title": "OG eBay Order Link",
    "default_popup": "options.html"
  }
}
