{
  "manifest_version": 3,
  "name": "Invsto Live Capture",
  "version": "1.6.1",
  "description": "Capture eBay Live sales and print saved bag labels from Stream Manager.",
  "permissions": ["storage", "alarms"],
  "background": {"service_worker": "worker.js"},
  "content_scripts": [
    {"matches": ["https://www.ebay.com/ebaylive/host/events/*"], "js": ["parser.js", "bag-label.js", "capture.js"]},
    {"matches": ["https://antdamus.github.io/Invsto/live-sales.html*"], "js": ["receiver.js"]}
  ]
}
