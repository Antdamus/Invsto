# Local-only Email Triage regression harness settings.
# Copy to tests/email-triage/.env.codex or tests/email-triage/.env.local.
# Do not commit real values.

# Local static server. The Playwright config starts python3 -m http.server for localhost URLs.
EMAIL_TRIAGE_BASE_URL=http://127.0.0.1:4173
EMAIL_TRIAGE_START_SERVER=true

# Either provide an admin login for the setup project, or provide a saved storage state.
EMAIL_TRIAGE_ADMIN_EMAIL=
EMAIL_TRIAGE_ADMIN_PASSWORD=
EMAIL_TRIAGE_STORAGE_STATE=tests/email-triage/.auth/admin.json

# Optional overrides. The harness can read these from email-triage.html at runtime,
# so they are only needed if you want explicit env-driven configuration.
SUPABASE_URL=
SUPABASE_ANON_KEY=

# Not required for normal runs. Use only if you intentionally want Node-side
# read-only verification to bypass RLS for audit/debugging.
EMAIL_TRIAGE_USE_SERVICE_ROLE=false
SUPABASE_SERVICE_ROLE_KEY=

# Report/artifact output. These folders are gitignored.
EMAIL_TRIAGE_REPORT_DIR=tests/email-triage/reports

# Live operation gates. Defaults are false so a normal run is read-only apart
# from authentication/session setup.
EMAIL_TRIAGE_RUN_SYNC_RECENT=false
EMAIL_TRIAGE_RUN_REFRESH_TIMELINE=false
EMAIL_TRIAGE_RUN_CLASSIFY_UNCLASSIFIED=false
EMAIL_TRIAGE_RUN_RECLASSIFY_RECENT=false
EMAIL_TRIAGE_RUN_BACKFILL_ARCHIVE=false
EMAIL_TRIAGE_RUN_BACKFILL_CLASSIFY_NEW=false
EMAIL_TRIAGE_RUN_BACKFILL_RECLASSIFY_ALL=false

# Required only with EMAIL_TRIAGE_RUN_BACKFILL_RECLASSIFY_ALL=true.
EMAIL_TRIAGE_CONFIRM_FULL_RECLASSIFY_ALL=

